API_ID=
API_HASH=
BOT_TOKEN=
LOGGER_ID=
MONGO_DB_URI=
OWNER_ID=
STRING_SESSION=
YTPROXY_URL=
YT_API_KEY=

# ─── Telegram Storage Channel + MongoDB Music Cache ───────────────────────
# Numeric id (with -100 prefix) of the PRIVATE Telegram channel that will be
# used as permanent storage for cached music. Create a private channel, post
# one message in it, then promote at least ONE of your assistant userbots
# (the same accounts whose STRING_SESSIONs you set above) to admin with the
# "Post Messages" permission. Then put the channel id here.
# Leave at 0 to disable the cache system (bot keeps working as before).
STORAGE_CHANNEL_ID=0
# Master toggle for the music cache. Set to false to fully disable cache
# lookups and background uploads even if STORAGE_CHANNEL_ID is set.
MUSIC_CACHE_ENABLED=true
# Max simultaneous background uploads to the storage channel.
# Playback is never throttled by this — only cache-upload workers.
CACHE_UPLOAD_CONCURRENCY=2
